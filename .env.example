# Copy this file to .env (which is not committed) and fill in the values from
# Supabase dashboard -> Project Settings -> API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...) or legacy service_role key. Never put it into web/ or commit it.
SUPABASE_SECRET_KEY=sb_secret_...
